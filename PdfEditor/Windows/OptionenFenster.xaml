<ui:FluentWindow x:Class="PdfEditor.Windows.OptionenFenster"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Optionen"
                 Width="600" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <StackPanel>
        <ui:TitleBar Title="Optionen" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="20,8,20,20">
            <TextBlock Text="Scannen" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Neue Scans werden direkt als PDF in diesem Ordner gespeichert und geöffnet."
                       Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Ordner für neue Scans" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="OrdnerFeld" TextChanged="Eingabe_TextChanged" />
                <ui:Button Grid.Column="1" Content="Durchsuchen..." Icon="{ui:SymbolIcon FolderOpen24}"
                           Margin="8,0,0,0" Click="Durchsuchen_Click" />
            </Grid>

            <TextBlock Text="Dateiname" Margin="0,0,0,4" />
            <ui:TextBox x:Name="DateinameFeld" TextChanged="Eingabe_TextChanged" />
            <TextBlock Text="Platzhalter: {Datum} = Jahr-Monat-Tag, {Zeit} = Stunde-Minute-Sekunde. Die Endung .pdf wird ergänzt."
                       Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBlock x:Name="BeispielText" FontSize="12" TextWrapping="Wrap" />

            <DockPanel Margin="0,20,0,0" LastChildFill="False">
                <ui:Button DockPanel.Dock="Left" Content="Standard" Click="Standard_Click"
                           ToolTip="Standardordner und -dateinamen wiederherstellen" />
                <ui:Button DockPanel.Dock="Right" Content="Abbrechen" MinWidth="100" IsCancel="True" />
                <ui:Button DockPanel.Dock="Right" Content="OK" Appearance="Primary" MinWidth="100"
                           Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>

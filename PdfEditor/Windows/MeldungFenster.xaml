<ui:FluentWindow x:Class="PdfEditor.Windows.MeldungFenster"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 MinWidth="0" MinHeight="0"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <StackPanel>
        <ui:TitleBar x:Name="Titelleiste" ShowMinimize="False" ShowMaximize="False" />

        <Grid Margin="20,8,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:SymbolIcon x:Name="Symbol" FontSize="32" VerticalAlignment="Top" Margin="0,0,16,0" />
            <TextBlock x:Name="Nachricht" Grid.Column="1" TextWrapping="Wrap" FontSize="14"
                       VerticalAlignment="Center" />

            <StackPanel x:Name="Knöpfe" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,24,0,0" />
        </Grid>
    </StackPanel>
</ui:FluentWindow>

<ui:FluentWindow x:Class="PdfEditor.Windows.KennwortFenster"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 MinWidth="0" MinHeight="0"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <StackPanel>
        <ui:TitleBar x:Name="Titelleiste" ShowMinimize="False" ShowMaximize="False" />

        <Grid Margin="20,8,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:SymbolIcon Symbol="LockClosed24" FontSize="32" VerticalAlignment="Top"
                           Margin="0,0,16,0" Foreground="#0E7C7B" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="Nachricht" TextWrapping="Wrap" FontSize="14" />
                <TextBlock Text="Kennwort" Margin="0,14,0,4" />
                <PasswordBox x:Name="Kennwort1" />
                <StackPanel x:Name="WiederholenBereich">
                    <TextBlock Text="Kennwort wiederholen" Margin="0,10,0,4" />
                    <PasswordBox x:Name="Kennwort2" />
                </StackPanel>
                <TextBlock x:Name="Hinweis" Foreground="#C42B1C" TextWrapping="Wrap"
                           Margin="0,8,0,0" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <ui:Button x:Name="OkKnopf" MinWidth="100" Appearance="Primary" IsDefault="True"
                               Click="Ok_Click" />
                    <ui:Button Content="Abbrechen" MinWidth="100" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</ui:FluentWindow>

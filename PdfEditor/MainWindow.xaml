<ui:FluentWindow x:Class="PdfEditor.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:dd="urn:gong-wpf-dragdrop"
                 xmlns:m="clr-namespace:PdfEditor.Models"
                 xmlns:conv="clr-namespace:PdfEditor.Converters"
                 xmlns:local="clr-namespace:PdfEditor"
                 Title="{Binding Titel}"
                 Icon="pack://application:,,,/perpdf.ico"
                 Width="1280" Height="860"
                 MinWidth="900" MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 AllowDrop="True"
                 DragOver="Fenster_DragOver"
                 Drop="Fenster_Drop">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolZuSichtbar" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
        <!-- Invertierter Bool-zu-Sichtbarkeit-Converter (false → Visible, true → Collapsed) -->
        <conv:InvertBoolToVisibilityConverter x:Key="InvertBoolZuSichtbar" />
        <!-- Konvertiert 0-basierten Seitenindex in 1-basierte Seitennummer (z. B. "S. 3") -->
        <conv:SeitenNummerConverter x:Key="SeitenNummer" />
        <conv:EnumGleichConverter x:Key="EnumGleich" />

        <!-- ===== Menüband (Ribbon) ===== -->
        <!-- Eine Befehlsgruppe: rechter Trennstrich (Haarlinie). -->
        <Style x:Key="MenübandGruppe" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource PpHaarlinie}" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <!-- Untertitel einer Gruppe (z. B. „Datei“). -->
        <Style x:Key="MenübandGruppenTitel" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- Großer Knopf: Symbol über Text, ruhig (transparent) bis zum Überfahren. -->
        <Style x:Key="MenübandKnopf" TargetType="ButtonBase">
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Rahmen" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Umschalt-Knopf (Modi): eingeschaltet als Teal-Tönung. -->
        <Style x:Key="MenübandUmschalter" TargetType="ToggleButton" BasedOn="{StaticResource MenübandKnopf}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PpTeal100}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PpTeal200}" />
                    <Setter Property="Foreground" Value="{DynamicResource PpAkzent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Kleiner quadratischer Symbolknopf (Titelleiste, Zoom, Karten). -->
        <Style x:Key="SymbolKnopf" TargetType="ButtonBase" BasedOn="{StaticResource MenübandKnopf}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Knöpfe der schwebenden Leisten über Text/Bild/Symbol auf der Seite. -->
        <Style x:Key="LeistenKnopf" TargetType="ButtonBase" BasedOn="{StaticResource SymbolKnopf}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
        <Style x:Key="LeistenUmschalter" TargetType="ToggleButton" BasedOn="{StaticResource LeistenKnopf}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PpTeal100}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PpTeal200}" />
                    <Setter Property="Foreground" Value="{DynamicResource PpAkzent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Schriftauswahl in der Textleiste: jeder Name in seiner Schrift, virtualisiert. -->
        <Style x:Key="SchriftAuswahl" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Speichern rechts im Menüband: neutral, bei ungespeicherten Änderungen gefüllter Akzent
             (höchstens ein gefüllter Akzentknopf je Ansicht). -->
        <Style x:Key="SpeichernKnopf" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0,14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Rahmen" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IstGeändert}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PpAkzent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PpAkzentRand}" />
                    <Setter Property="Foreground" Value="{DynamicResource PpAufAkzent}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IstGeändert}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource PpAkzentHover}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Registerkarte des Menübands: Text, aktiv mit kurzem Teal-Strich darunter. -->
        <Style x:Key="MenübandReiter" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent" Height="34">
                            <ContentPresenter ContentSource="Header" Margin="12,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Border x:Name="Strich" Width="16" Height="3" CornerRadius="1.5"
                                    Background="{DynamicResource PpAkzent}" Margin="0,0,0,3"
                                    VerticalAlignment="Bottom" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Strich" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Segmentschalter (Seiten / Inhalt). -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Rahmen" CornerRadius="4" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rahmen" Property="Background" Value="{DynamicResource PpFläche}" />
                                <Setter TargetName="Rahmen" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Beschriftung unter einem Knopf-Symbol. -->
        <Style x:Key="MenübandKnopfText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <!-- Tastenkürzel-Kappe im Startzustand. -->
        <Style x:Key="Taste" TargetType="Border">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource PpHaarlinie}" />
            <Setter Property="Background" Value="{DynamicResource PpFläche}" />
        </Style>
    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding DruckenBefehl}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Row 0: Titelleiste (Logo, Dokument-Reiter, Suche) -->
            <RowDefinition Height="Auto" />  <!-- Row 1: Menüband -->
            <RowDefinition Height="Auto" />  <!-- Row 2: Modus-Hinweis (Felder bearbeiten) -->
            <RowDefinition Height="*" />     <!-- Row 3: Inhalt -->
            <RowDefinition Height="Auto" />  <!-- Row 4: Status -->
        </Grid.RowDefinitions>

        <!-- Titelleiste: Signet + Wortbild, Dokument-Reiter, Suche, Fenstersteuerung.
             Header/TrailingContent bleiben klickbar; freie Fläche dazwischen zieht das Fenster. -->
        <ui:TitleBar Grid.Row="0" Height="44">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Height="44" Margin="12,0,0,0">
                    <Grid Width="26" Height="26" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#15A39A" Offset="0" />
                                    <GradientStop Color="#0E7C7B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Rectangle Width="10" Height="2.3" RadiusX="1.1" RadiusY="1.1" Fill="#FBFAF7"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,8,0,0" />
                        <Rectangle Width="14" Height="2.3" RadiusX="1.1" RadiusY="1.1" Fill="#FBFAF7" Opacity="0.7"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,12,0,0" />
                        <Ellipse Width="6" Height="6" Fill="#F4A93B"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="Bold"
                               FontFamily="Segoe UI Variable Display, Segoe UI">
                        <Run Text="per" Foreground="{DynamicResource PpInk}" /><Run Text="PDF" Foreground="{DynamicResource PpAkzent}" />
                    </TextBlock>

                    <!-- Dokument-Reiter. shortcut: kein Überlauf-Scrollen bei sehr vielen Tabs,
                         bei Bedarf auf ein breitenbegrenztes Panel mit Scrollpfeilen umstellen. -->
                    <ItemsControl x:Name="TabLeiste" Margin="20,0,0,0" VerticalAlignment="Bottom">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DokumentTab}">
                                <Border x:Name="TabRahmen"
                                        Height="36" Margin="0,0,2,0"
                                        Padding="12,0,6,0"
                                        CornerRadius="6,6,0,0"
                                        BorderThickness="1,1,1,0"
                                        BorderBrush="Transparent"
                                        Background="Transparent"
                                        MouseLeftButtonDown="TabReiter_Click"
                                        Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon x:Name="TabSymbol" Symbol="DocumentPdf24" FontSize="16"
                                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="TabTitelText"
                                                   Text="{Binding TabTitel}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ViewModel.Pfad}" />
                                        <Ellipse x:Name="GeändertZeichen"
                                                 Width="7" Height="7" Margin="8,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource PpOrange}"
                                                 ToolTip="Ungespeicherte Änderungen"
                                                 Visibility="{Binding ViewModel.IstGeändert,
                                                     Converter={StaticResource BoolZuSichtbar}}" />
                                        <Button Style="{StaticResource SymbolKnopf}"
                                                Width="24" Height="24" Margin="4,0,0,0"
                                                ToolTip="Tab schließen"
                                                Click="TabSchließen_Click"
                                                Tag="{Binding}">
                                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource SymbolKnopf}" Width="28" Height="28"
                            Margin="4,0,0,4" VerticalAlignment="Bottom"
                            Click="ÖffnenInNeuemTab_Click" ToolTip="PDF öffnen">
                        <ui:SymbolIcon Symbol="Add20" FontSize="16" />
                    </Button>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <!-- Suchfeld-Optik: öffnet das schwebende Suchfeld (Strg+F). -->
                <Button Width="260" Height="30" Margin="0,0,12,0" VerticalAlignment="Center"
                        IsEnabled="{Binding HatDokument}" Click="SuchenÖffnen_Click"
                        ToolTip="Im Dokument suchen (Strg+F)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Feld" CornerRadius="4" Padding="10,0" BorderThickness="1,1,1,1"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Search20" FontSize="16" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Im Dokument suchen  (Strg+F)" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Feld" Property="BorderBrush" Value="{DynamicResource PpTeal200}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Feld" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Menüband (Ribbon): Registerkarten, rechts dauerhaft Drucken + Speichern -->
        <Border Grid.Row="1" BorderThickness="0,1,0,1"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Bottom" Margin="0,0,12,20">
                    <Button Style="{StaticResource SymbolKnopf}" Width="36" Height="36" Margin="0,0,4,0"
                            Command="{Binding DruckenBefehl}" ToolTip="Drucken (Strg+P)">
                        <ui:SymbolIcon Symbol="Print20" FontSize="20" />
                    </Button>
                    <Button Style="{StaticResource SpeichernKnopf}"
                            Command="{Binding SpeichernBefehl}" ToolTip="Dokument speichern">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save20" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Speichern" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TabControl Grid.Column="0" ItemContainerStyle="{StaticResource MenübandReiter}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="8,0,0,0" />
                                <ContentPresenter ContentSource="SelectedContent" />
                            </DockPanel>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- ===== Start: Datei ===== -->
                    <TabItem Header="Start">
                        <StackPanel Orientation="Horizontal" Margin="4,2,4,6">
                            <Border Style="{StaticResource MenübandGruppe}" BorderThickness="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Datei"
                                               Style="{StaticResource MenübandGruppenTitel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Click="ÖffnenInNeuemTab_Click" ToolTip="PDF öffnen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Open28" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Öffnen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Command="{Binding SpeichernBefehl}" ToolTip="Dokument speichern">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Save28" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Speichern" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Command="{Binding SpeichernUnterBefehl}" ToolTip="Unter neuem Namen speichern">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="SaveEdit24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Speichern unter" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Command="{Binding DruckenBefehl}" ToolTip="Dokument drucken (Strg+P)">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Print28" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Drucken" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Click="Scannen_Click" ToolTip="Dokument scannen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="ScanDash28" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Scannen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ===== Seiten: Bearbeiten + Dokument ===== -->
                    <TabItem Header="Seiten">
                        <StackPanel Orientation="Horizontal" Margin="4,2,4,6">
                            <Border Style="{StaticResource MenübandGruppe}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Seiten"
                                               Style="{StaticResource MenübandGruppenTitel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Command="{Binding SeiteLöschenBefehl}" ToolTip="Ausgewählte Seite(n) löschen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Seite löschen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Command="{Binding LinksDrehenBefehl}" ToolTip="Ausgewählte Seite(n) nach links drehen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Links drehen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Command="{Binding RechtsDrehenBefehl}" ToolTip="Ausgewählte Seite(n) nach rechts drehen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Rechts drehen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource MenübandGruppe}" BorderThickness="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Dokument"
                                               Style="{StaticResource MenübandGruppenTitel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                IsEnabled="{Binding HatDokument}"
                                                Click="ZusammenführenÖffnen_Click" ToolTip="Weitere PDFs anfügen oder zusammenführen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Zusammenführen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                IsEnabled="{Binding HatDokument}"
                                                Click="SeitenExtrahierenÖffnen_Click" ToolTip="Ausgewählte Seiten als neues PDF extrahieren">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="DocumentArrowRight24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Extrahieren" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                IsEnabled="{Binding HatDokument}"
                                                Click="SeitenEntfernenÖffnen_Click" ToolTip="Seiten per Auswahl oder Seitenbereich (z. B. 3-10) entfernen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="DocumentDismiss24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Seiten entfernen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ===== Anmerken: Einfügen, Stift, Unterschrift ===== -->
                    <TabItem Header="Anmerken">
                        <StackPanel Orientation="Horizontal" Margin="4,2,4,6">
                            <Border Style="{StaticResource MenübandGruppe}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Einfügen"
                                               Style="{StaticResource MenübandGruppenTitel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TextEinfügenButton" Style="{StaticResource MenübandKnopf}"
                                                Command="{Binding TextEinfügenBefehl}" ToolTip="Textfeld auf die Seite setzen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="TextAdd20" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Text einfügen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Command="{Binding BildEinfügenBefehl}"
                                                ToolTip="Bild aus Datei einfügen – oder mit Strg+V direkt aus der Zwischenablage">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="ImageAdd24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Bild einfügen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <ui:DropDownButton Margin="1,0" Padding="8,6" VerticalAlignment="Stretch"
                                                           Background="Transparent" BorderBrush="Transparent"
                                                           IsEnabled="{Binding HatDokument}"
                                                           ToolTip="Kreuz, Häkchen, Punkt, Umrandung oder Durchstreichung einfügen">
                                            <ui:DropDownButton.Content>
                                                <StackPanel>
                                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="22" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Markierung" Style="{StaticResource MenübandKnopfText}" />
                                                </StackPanel>
                                            </ui:DropDownButton.Content>
                                            <ui:DropDownButton.Flyout>
                                                <ContextMenu>
                                                    <MenuItem Header="Kreuz" Tag="{x:Static m:SymbolArt.Kreuz}" Click="SymbolMenü_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="✕" FontWeight="Bold" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Häkchen" Tag="{x:Static m:SymbolArt.Häkchen}" Click="SymbolMenü_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="✓" FontWeight="Bold" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Punkt" Tag="{x:Static m:SymbolArt.Punkt}" Click="SymbolMenü_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="●" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Umranden" Tag="{x:Static m:SymbolArt.Umranden}" Click="SymbolMenü_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="▭" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Durchstreichen" Tag="{x:Static m:SymbolArt.Durchstreichen}" Click="SymbolMenü_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="—" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </ui:DropDownButton.Flyout>
                                        </ui:DropDownButton>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource MenübandGruppe}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Stift"
                                               Style="{StaticResource MenübandGruppenTitel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource MenübandUmschalter}"
                                                      IsEnabled="{Binding HatDokument}"
                                                      IsChecked="{Binding MarkerModus, Mode=TwoWay}"
                                                      ToolTip="Leuchtstift: mit gedrückter Maustaste über den Text ziehen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Highlight24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Textmarker" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource MenübandUmschalter}"
                                                      IsEnabled="{Binding HatDokument}"
                                                      IsChecked="{Binding RadiererModus, Mode=TwoWay}"
                                                      ToolTip="Markierungsstriche durch Anklicken/Ziehen entfernen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Eraser24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Radiergummi" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource MenübandGruppe}" BorderThickness="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Unterschrift"
                                               Style="{StaticResource MenübandGruppenTitel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox MinWidth="170" Height="46" Margin="2,0,6,0" VerticalAlignment="Center"
                                                  ItemsSource="{Binding Unterschriften}"
                                                  SelectedItem="{Binding ZuEinfügendeUnterschrift, Mode=TwoWay}"
                                                  ToolTip="Gespeicherte Unterschrift auswählen – wird sofort eingefügt">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:Unterschrift}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="White" Margin="0,0,6,0" Padding="1">
                                                            <Image Source="{Binding Bild}" Height="22" Stretch="Uniform" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Command="{Binding UnterschriftHinzufügenBefehl}"
                                                ToolTip="Unterschrift als Bild importieren">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Signature24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Importieren" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ===== Formular ===== -->
                    <TabItem Header="Formular">
                        <StackPanel Orientation="Horizontal" Margin="4,2,4,6">
                            <Border Style="{StaticResource MenübandGruppe}" BorderThickness="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Formularfelder"
                                               Style="{StaticResource MenübandGruppenTitel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:DropDownButton Margin="1,0" Padding="8,6" VerticalAlignment="Stretch"
                                                           Background="Transparent" BorderBrush="Transparent"
                                                           IsEnabled="{Binding HatDokument}"
                                                           ToolTip="Ausfüllbares Formularfeld anlegen, dann auf die Seite klicken">
                                            <ui:DropDownButton.Content>
                                                <StackPanel>
                                                    <ui:SymbolIcon Symbol="TextField24" FontSize="22" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Formularfeld" Style="{StaticResource MenübandKnopfText}" />
                                                </StackPanel>
                                            </ui:DropDownButton.Content>
                                            <ui:DropDownButton.Flyout>
                                                <ContextMenu>
                                                    <MenuItem Header="Textfeld" Tag="{x:Static m:EntwurfFeldTyp.Textfeld}" Click="FeldMenü_Click" />
                                                    <MenuItem Header="Mehrzeiliges Textfeld" Tag="{x:Static m:EntwurfFeldTyp.MehrzeiligesTextfeld}" Click="FeldMenü_Click" />
                                                    <MenuItem Header="Kontrollkästchen" Tag="{x:Static m:EntwurfFeldTyp.Kontrollkästchen}" Click="FeldMenü_Click" />
                                                    <MenuItem Header="Optionsfelder (Auswahl)" Tag="{x:Static m:EntwurfFeldTyp.Optionsfeld}" Click="FeldMenü_Click" />
                                                    <MenuItem Header="Dropdown" Tag="{x:Static m:EntwurfFeldTyp.Dropdown}" Click="FeldMenü_Click" />
                                                    <MenuItem Header="Listenfeld" Tag="{x:Static m:EntwurfFeldTyp.Listenfeld}" Click="FeldMenü_Click" />
                                                    <Separator />
                                                    <MenuItem Header="Datumsfeld" Tag="{x:Static m:EntwurfFeldTyp.Datum}" Click="FeldMenü_Click" />
                                                    <MenuItem Header="Zahlenfeld" Tag="{x:Static m:EntwurfFeldTyp.Zahl}" Click="FeldMenü_Click" />
                                                    <MenuItem Header="Unterschriftsfeld" Tag="{x:Static m:EntwurfFeldTyp.Unterschrift}" Click="FeldMenü_Click" />
                                                </ContextMenu>
                                            </ui:DropDownButton.Flyout>
                                        </ui:DropDownButton>
                                        <ToggleButton Style="{StaticResource MenübandUmschalter}"
                                                      IsEnabled="{Binding HatDokument}"
                                                      IsChecked="{Binding FelderBearbeitenModus, Mode=TwoWay}"
                                                      ToolTip="Vorhandene Formularfelder verschieben, ändern oder löschen: Feld anklicken zum Bearbeiten, ✕ zum Löschen">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Felder bearbeiten" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ===== Ansicht: Zoom, Anzeige, Info ===== -->
                    <TabItem Header="Ansicht">
                        <StackPanel Orientation="Horizontal" Margin="4,2,4,6">
                            <Border Style="{StaticResource MenübandGruppe}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Zoom"
                                               Style="{StaticResource MenübandGruppenTitel}" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Icon="{ui:SymbolIcon ZoomOut24}" Margin="2,0"
                                                   Command="{Binding ZoomMinusBefehl}" ToolTip="Verkleinern" />
                                        <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center"
                                                   MinWidth="48" TextAlignment="Center" />
                                        <ui:Button Icon="{ui:SymbolIcon ZoomIn24}" Margin="2,0"
                                                   Command="{Binding ZoomPlusBefehl}" ToolTip="Vergrößern" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource MenübandGruppe}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Anzeige"
                                               Style="{StaticResource MenübandGruppenTitel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SuchButton" Style="{StaticResource MenübandKnopf}"
                                                IsEnabled="{Binding HatDokument}"
                                                ToolTip="Im Dokument suchen (Strg+F)"
                                                Click="SuchenÖffnen_Click">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Search24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Suchen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <ToggleButton Style="{StaticResource MenübandUmschalter}"
                                                      IsEnabled="{Binding HatDokument}"
                                                      IsChecked="{Binding KommentareSichtbar, Mode=TwoWay}"
                                                      ToolTip="Kommentar-Seitenleiste ein-/ausblenden. Text markieren und per Rechtsklick kommentieren.">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Comment24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Kommentare" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="DunkelUmschalter" Style="{StaticResource MenübandUmschalter}"
                                                      Click="DesignUmschalten_Click"
                                                      ToolTip="Zwischen hellem und dunklem Design wechseln">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Dunkel" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource MenübandGruppe}" BorderThickness="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="Info"
                                               Style="{StaticResource MenübandGruppenTitel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Click="OptionenÖffnen_Click" ToolTip="Optionen von perPDF">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Settings28" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Optionen" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MenübandKnopf}"
                                                Click="ÜberFensterÖffnen" ToolTip="Über perPDF">
                                            <StackPanel>
                                                <ui:SymbolIcon Symbol="Info28" FontSize="22" HorizontalAlignment="Center" />
                                                <TextBlock Text="Über" Style="{StaticResource MenübandKnopfText}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- Schwebendes Suchfeld (Strg+F / Suchen-Schaltfläche) -->
        <Border x:Name="SuchPanel" Grid.Row="3" Panel.ZIndex="100"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,28,0"
                Visibility="Collapsed"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Opacity="0.18" ShadowDepth="2" Direction="270" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SuchFeld" Width="220" Margin="0,0,6,0"
                         VerticalContentAlignment="Center"
                         KeyDown="SuchFeld_KeyDown"
                         TextChanged="SuchFeld_TextChanged" />
                <TextBlock x:Name="TrefferAnzeige" VerticalAlignment="Center"
                           MinWidth="55" Margin="0,0,4,0" TextAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button x:Name="VorigerTrefferKnopf" Content="↑" Width="26" Height="26"
                        Padding="0" Margin="0,0,2,0" VerticalAlignment="Center"
                        Click="VorigerTreffer_Click" />
                <Button x:Name="NächsterTrefferKnopf" Content="↓" Width="26" Height="26"
                        Padding="0" Margin="0,0,6,0" VerticalAlignment="Center"
                        Click="NächsterTreffer_Click" />
                <Button x:Name="SuchPanelSchließenKnopf" Content="✕" Width="24" Height="24"
                        Padding="0" VerticalAlignment="Center"
                        Click="SuchPanelSchließen_Click" />
            </StackPanel>
        </Border>

        <!-- Modus-Hinweis: nur während „Felder bearbeiten“ -->
        <Border Grid.Row="2" Padding="16,8,12,8" BorderThickness="0,0,0,1"
                Background="{DynamicResource PpTeal50}" BorderBrush="{DynamicResource PpTeal200}"
                Visibility="{Binding FelderBearbeitenModus, Converter={StaticResource BoolZuSichtbar}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Fertig" Height="30" Padding="14,0" FontSize="12"
                        Click="FelderBearbeitenFertig_Click"
                        ToolTip="Modus beenden – Änderungen werden eingebacken" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Edit24" FontSize="18" Margin="0,0,10,0"
                                   Foreground="{DynamicResource PpAkzent}" />
                    <TextBlock Text="Felder bearbeiten" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Feld anklicken zum Ändern, ✕ zum Löschen. Esc beendet den Modus – Änderungen werden dann eingebacken." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Hauptbereich: Miniaturen | Seitenansicht | Kommentar-Seitenleiste -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Linke Seitenleiste: TOC oder Seitenvorschauen -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toggle-Leiste: nur sichtbar wenn TOC vorhanden -->
                <Border Grid.Row="0"
                        Visibility="{Binding HatInhaltsverzeichnis, Converter={StaticResource BoolZuSichtbar}}"
                        Margin="12,12,12,8" Padding="2" CornerRadius="6"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <UniformGrid Columns="2">
                        <RadioButton Content="Seiten" Style="{StaticResource Segment}"
                                     IsChecked="{Binding ZeigeInhaltsverzeichnis, Converter={StaticResource InvertBool}, Mode=TwoWay}" />
                        <RadioButton Content="Inhalt" Style="{StaticResource Segment}"
                                     IsChecked="{Binding ZeigeInhaltsverzeichnis, Mode=TwoWay}" />
                    </UniformGrid>
                </Border>

                <!-- Thumbnails (sichtbar wenn ZeigeInhaltsverzeichnis = false) -->
                <!-- Umsortieren nur über den Ziehgriff (DragSourceIgnore auf der Kachel),
                     plus erhöhte Drag-Schwelle, damit ein Klick zum Auswählen nicht
                     versehentlich die Seitenreihenfolge ändert. -->
                <!-- Extended-Selection: Strg/Umschalt+Klick wählt mehrere Seiten; das
                     Kontextmenü und Entf wirken auf die gesamte Auswahl. Die Auswahl
                     wird ins ViewModel gespiegelt (SelectionChanged), damit auch die
                     Symbolleisten-Befehle mehrere Seiten treffen. -->
                <ListBox x:Name="MiniaturListe" Grid.Row="1"
                         ItemsSource="{Binding Seiten}"
                         SelectedIndex="{Binding AktuelleSeite, Mode=TwoWay}"
                         SelectionMode="Extended"
                         SelectionChanged="MiniaturListe_SelectionChanged"
                         PreviewMouseRightButtonDown="MiniaturListe_PreviewMouseRightButtonDown"
                         KeyDown="MiniaturListe_KeyDown"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding ZeigeInhaltsverzeichnis, Converter={StaticResource InvertBoolZuSichtbar}}"
                         dd:DragDrop.IsDragSource="True"
                         dd:DragDrop.IsDropTarget="True"
                         dd:DragDrop.MinimumHorizontalDragDistance="18"
                         dd:DragDrop.MinimumVerticalDragDistance="18"
                         Background="Transparent" BorderThickness="0">
                    <!-- Eigener Container: keine Fluent-Zeilenhervorhebung; die Auswahl
                         zeigt der Teal-Rahmen um die Miniatur (DataTemplate). -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="0,4" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:SeitenElement}">
                            <Grid x:Name="Kachel" Margin="4" Background="Transparent">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Seite(n) löschen" InputGestureText="Entf"
                                                  Click="MiniaturLöschen_Click" />
                                        <Separator />
                                        <MenuItem Header="Nach links drehen"
                                                  Click="MiniaturLinksDrehen_Click" />
                                        <MenuItem Header="Nach rechts drehen"
                                                  Click="MiniaturRechtsDrehen_Click" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <!-- Inhalt der Kachel: als Ziehquelle ignoriert, damit ein
                                     Klick hier nur auswählt und kein Verschieben startet. -->
                                <StackPanel HorizontalAlignment="Center"
                                            dd:DragDrop.DragSourceIgnore="True">
                                    <Border x:Name="AuswahlRahmen" Padding="3" CornerRadius="6"
                                            BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                                        <Border BorderBrush="#14000000" BorderThickness="1" Background="White">
                                            <Image Source="{Binding Vorschau}" Stretch="Uniform" MaxHeight="200" />
                                        </Border>
                                    </Border>
                                    <TextBlock x:Name="SeitenNr" Text="{Binding Nummer}" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <!-- Ziehgriff: nur hier beginnt das Umsortieren. Erscheint
                                     dezent beim Überfahren der Kachel. -->
                                <Border x:Name="Ziehgriff"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,4,4,0" Padding="6,2"
                                        CornerRadius="4" Opacity="0"
                                        Background="{DynamicResource PpAkzent}" Cursor="SizeAll"
                                        ToolTip="Ziehen, um die Seitenreihenfolge zu ändern">
                                    <TextBlock Text="⠿⠿" Foreground="{DynamicResource PpAufAkzent}" FontSize="11"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Kachel" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ziehgriff" Property="Opacity" Value="0.95" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="AuswahlRahmen" Property="BorderBrush" Value="{DynamicResource PpAkzent}" />
                                    <Setter TargetName="AuswahlRahmen" Property="Background" Value="{DynamicResource PpTeal50}" />
                                    <Setter TargetName="SeitenNr" Property="Foreground" Value="{DynamicResource PpAkzent}" />
                                    <Setter TargetName="SeitenNr" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- TOC-Baum (sichtbar wenn ZeigeInhaltsverzeichnis = true) -->
                <TreeView x:Name="TocBaum" Grid.Row="1"
                          ItemsSource="{Binding Inhaltsverzeichnis}"
                          Visibility="{Binding ZeigeInhaltsverzeichnis, Converter={StaticResource BoolZuSichtbar}}"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectedItemChanged="TocBaum_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IstAufgeklappt, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="2,3" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type m:InhaltsEintrag}"
                                                  ItemsSource="{Binding Kinder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Titel}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Titel}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                                <!-- SeitenIndex ist 0-basiert; Converter zeigt 1-basiert -->
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SeitenIndex, Converter={StaticResource SeitenNummer}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SeitenIndex}" Value="-1">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Große Ansicht der aktuellen Seite mit Overlay -->
            <Grid Grid.Column="2" Background="{DynamicResource PpLeinwand}">
                <!-- Unten zusätzlicher Abstand, damit die schwebende Zoomleiste die Seite nicht verdeckt. -->
                <ScrollViewer x:Name="SeitenScroll" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto" Padding="24,24,24,72">
                    <Grid x:Name="SeitenHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="SeitenBild" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Canvas x:Name="OverlayCanvas" Background="Transparent" />
                    </Grid>
                </ScrollViewer>

                <!-- Schwebende Zoomleiste -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                        Padding="4" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource PpFläche}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HatDokument}" Value="True" />
                                        <Condition Binding="{Binding FelderBearbeitenModus}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SymbolKnopf}" Command="{Binding ZoomMinusBefehl}" ToolTip="Verkleinern">
                            <ui:SymbolIcon Symbol="ZoomOut20" FontSize="18" />
                        </Button>
                        <TextBlock Text="{Binding ZoomText}" MinWidth="48" FontSize="12"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SymbolKnopf}" Command="{Binding ZoomPlusBefehl}" ToolTip="Vergrößern">
                            <ui:SymbolIcon Symbol="ZoomIn20" FontSize="18" />
                        </Button>
                        <Rectangle Width="1" Height="18" Margin="4,0" Fill="{DynamicResource PpHaarlinie}" />
                        <TextBlock Text="{Binding SeitenStatus}" FontSize="12" Margin="8,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Legende während „Felder bearbeiten“ -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                        Padding="12,6" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource PpFläche}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Visibility="{Binding FelderBearbeitenModus, Converter={StaticResource BoolZuSichtbar}}">
                    <StackPanel Orientation="Horizontal" TextElement.FontSize="12">
                        <Border Width="16" Height="10" CornerRadius="2" BorderThickness="1" Margin="0,0,6,0"
                                BorderBrush="{DynamicResource PpAkzent}" Background="#2815A39A" />
                        <TextBlock Text="Vorhandenes Feld" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Rectangle Width="16" Height="10" RadiusX="2" RadiusY="2" Margin="0,0,6,0"
                                   Stroke="{DynamicResource PpAkzent}" StrokeThickness="1.5" StrokeDashArray="2 1.5"
                                   Fill="#2815A39A" />
                        <TextBlock Text="Entwurf (noch nicht eingebacken)" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Startzustand: kein Dokument geöffnet -->
                <Grid Background="{DynamicResource PpLeinwand}"
                      Visibility="{Binding HatDokument, Converter={StaticResource InvertBoolZuSichtbar}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,32">
                        <Grid MaxWidth="600" MinWidth="420">
                            <Rectangle RadiusX="8" RadiusY="8" Fill="{DynamicResource PpFläche}"
                                       Stroke="{DynamicResource PpTeal500}" StrokeThickness="2" StrokeDashArray="4 3" />
                            <StackPanel Margin="32,48" HorizontalAlignment="Center">
                                <Border Width="72" Height="72" CornerRadius="36" BorderThickness="1"
                                        Background="{DynamicResource PpTeal50}" BorderBrush="{DynamicResource PpTeal200}">
                                    <ui:SymbolIcon Symbol="DocumentPdf32" FontSize="36"
                                                   Foreground="{DynamicResource PpAkzent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="PDF hierher ziehen" Margin="0,16,0,4" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PpAkzent}" HorizontalAlignment="Center" />
                                <TextBlock Text="oder eine Datei auswählen. Mehrere PDFs öffnen sich als Tabs."
                                           FontSize="13" Foreground="{DynamicResource PpInk}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                <Button Style="{StaticResource SpeichernKnopf}" Margin="0,20,0,0"
                                        HorizontalAlignment="Center" Click="ÖffnenInNeuemTab_Click"
                                        Background="{DynamicResource PpAkzent}" BorderBrush="{DynamicResource PpAkzentRand}"
                                        Foreground="{DynamicResource PpAufAkzent}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Open28" FontSize="18" Margin="0,0,8,0" />
                                        <TextBlock Text="PDF öffnen" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Foreground" Value="{DynamicResource PpInk}" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Resources>
                            <Border Style="{StaticResource Taste}"><TextBlock Text="Strg" /></Border>
                            <Border Style="{StaticResource Taste}"><TextBlock Text="F" /></Border>
                            <TextBlock Text="Suchen" FontSize="12" Margin="2,0,24,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border Style="{StaticResource Taste}"><TextBlock Text="Strg" /></Border>
                            <Border Style="{StaticResource Taste}"><TextBlock Text="V" /></Border>
                            <TextBlock Text="Bild einfügen" FontSize="12" Margin="2,0,24,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border Style="{StaticResource Taste}"><TextBlock Text="Strg" /></Border>
                            <Border Style="{StaticResource Taste}"><TextBlock Text="P" /></Border>
                            <TextBlock Text="Drucken" FontSize="12" Margin="2,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Kostenlos, ohne Konto, ohne Werbung." Margin="0,12,0,0" FontSize="12"
                                   Foreground="{DynamicResource PpGedämpft}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Kommentar-Seitenleiste -->
            <Border Grid.Column="3" Width="320"
                    Visibility="{Binding KommentareSichtbar, Converter={StaticResource BoolZuSichtbar}}"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1,0,0,0">
                <Border.Resources>
                    <Style x:Key="ErledigtKnopf" TargetType="Button" BasedOn="{StaticResource SymbolKnopf}">
                        <Setter Property="Width" Value="28" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Foreground" Value="{DynamicResource PpAkzent}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IstErledigt}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PpTeal100}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PpTeal200}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="AbgelehntKnopf" TargetType="Button" BasedOn="{StaticResource SymbolKnopf}">
                        <Setter Property="Width" Value="28" />
                        <Setter Property="Height" Value="28" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IstAbgelehnt}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PpAbgelehntGrund}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PpAbgelehntRand}" />
                                <Setter Property="Foreground" Value="{DynamicResource PpAbgelehnt}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>

                <DockPanel>
                    <!-- Kopfzeile -->
                    <Grid DockPanel.Dock="Top" Margin="16,12,8,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Kommentare" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0" MinWidth="20" Height="18" Padding="6,0" CornerRadius="9"
                                    Background="{DynamicResource PpTeal100}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kommentare.Count}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PpAkzent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Button Style="{StaticResource SymbolKnopf}" HorizontalAlignment="Right"
                                Click="KommentareSchließen_Click" ToolTip="Seitenleiste schließen">
                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="16" />
                        </Button>
                    </Grid>

                    <!-- Eingabefeld für neuen Kommentar -->
                    <Border DockPanel.Dock="Top" Margin="10,0,10,8" Padding="8" CornerRadius="6"
                            Visibility="{Binding HatEntwurf, Converter={StaticResource BoolZuSichtbar}}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource PpTeal500}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding Entwurf.Kopfzeile}" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="EntwurfText" MinHeight="56" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     KeyDown="EntwurfText_KeyDown" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Abbrechen" Margin="0,0,6,0" Padding="10,3"
                                        Click="EntwurfAbbrechen_Click" />
                                <ui:Button Content="Speichern" Appearance="Primary" Padding="10,3"
                                           Click="EntwurfSpeichern_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hinweis bei leerer Liste -->
                    <TextBlock DockPanel.Dock="Top" Margin="12,4" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Noch keine Kommentare. Text markieren, mit der rechten Maustaste anklicken und „Kommentar hinzufügen“ wählen.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kommentare.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Liste der Kommentare -->
                    <ListBox x:Name="KommentarListe" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding Kommentare}"
                             SelectedItem="{Binding AusgewählterKommentar, Mode=TwoWay}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="KommentarListe_ScrollChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Kommentar}">
                                <Border Margin="4,0,4,8" Padding="12" CornerRadius="6"
                                        Background="{DynamicResource PpFläche}"
                                        BorderBrush="{DynamicResource PpHaarlinie}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Kopfzeile}" FontWeight="SemiBold"
                                                           FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SeitenText}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Style="{StaticResource SymbolKnopf}" Width="28" Height="28"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Click="KommentarLöschen_Click" ToolTip="Kommentar löschen">
                                                <ui:SymbolIcon Symbol="Delete20" FontSize="16" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding Inhalt}" TextWrapping="Wrap" Margin="0,6,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ErledigtKnopf}" Margin="0,0,4,0"
                                                    Click="Erledigt_Click" ToolTip="Als erledigt markieren">
                                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" />
                                            </Button>
                                            <Button Style="{StaticResource AbgelehntKnopf}"
                                                    Click="Abgelehnt_Click" ToolTip="Als abgelehnt markieren">
                                                <ui:SymbolIcon Symbol="DismissCircle24" FontSize="18" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Antworten (auch aus anderen Programmen) -->
                                        <ItemsControl ItemsSource="{Binding Antworten}" Margin="10,8,0,0"
                                                      Visibility="{Binding HatAntworten, Converter={StaticResource BoolZuSichtbar}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:KommentarAntwort}">
                                                    <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="4"
                                                            Background="{DynamicResource PpTeal50}"
                                                            BorderBrush="{DynamicResource PpTeal200}"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Kopfzeile}" FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{Binding Inhalt}" TextWrapping="Wrap" FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Antwort verfassen -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBox Width="200" Tag="{Binding}" VerticalContentAlignment="Center"
                                                     KeyDown="AntwortText_KeyDown"
                                                     ToolTip="Antwort schreiben und mit Eingabetaste senden" />
                                            <Button Content="Antworten" Margin="6,0,0,0" Padding="8,2"
                                                    Click="AntwortSenden_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Formularfeld-Eigenschaften (Formular-Designer): Kopf, Abschnitte Allgemein /
                 Eingabe / Darstellung, unten „Feld löschen“. -->
            <Border Grid.Column="4" Width="320"
                    Visibility="{Binding HatAusgewähltesFeld, Converter={StaticResource BoolZuSichtbar}}"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Border.Resources>
                    <Style x:Key="Feldbeschriftung" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Style>
                    <Style x:Key="Abschnitt" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,0,0,12" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Style>
                    <Style x:Key="Trenner" TargetType="Rectangle">
                        <Setter Property="Height" Value="1" />
                        <Setter Property="Margin" Value="0,20" />
                        <Setter Property="Fill" Value="{DynamicResource PpHaarlinie}" />
                    </Style>
                    <Style x:Key="Farbmuster" TargetType="Border">
                        <Setter Property="Width" Value="14" />
                        <Setter Property="Height" Value="14" />
                        <Setter Property="CornerRadius" Value="3" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PpGedämpft}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </Border.Resources>
                <DockPanel>
                    <!-- Kopf: Symbolkachel, Titel, Feldtyp -->
                    <Border DockPanel.Dock="Top" Padding="16,12,8,12" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <DockPanel>
                            <Border Width="32" Height="32" CornerRadius="6" BorderThickness="1" Margin="0,0,10,0"
                                    Background="{DynamicResource PpTeal50}" BorderBrush="{DynamicResource PpTeal200}">
                                <ui:SymbolIcon Symbol="TextField24" FontSize="18" Foreground="{DynamicResource PpAkzent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SymbolKnopf}"
                                    Click="FeldAuswahlSchließen_Click" ToolTip="Auswahl aufheben">
                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="16" />
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Feld-Eigenschaften" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FeldTypText}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Fuß: Feld löschen -->
                    <Border DockPanel.Dock="Bottom" Padding="16,12" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="32"
                                Click="FeldLöschen_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete20" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="Feld löschen" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <!-- Allgemein -->
                            <TextBlock Text="Allgemein" Style="{StaticResource Abschnitt}" />
                            <TextBlock Text="Feldname" Style="{StaticResource Feldbeschriftung}" />
                            <TextBox Text="{Binding AusgewähltesFeld.FeldName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Standardwert" Margin="0,12,0,4" Style="{StaticResource Feldbeschriftung}" />
                            <TextBox Text="{Binding AusgewähltesFeld.Standardwert, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Vorbelegung; bei Kontrollkästchen 'ja', bei Optionsfeld die vorgewählte Option" />
                            <TextBlock Text="QuickInfo (Tooltip)" Margin="0,12,0,4" Style="{StaticResource Feldbeschriftung}" />
                            <TextBox Text="{Binding AusgewähltesFeld.QuickInfo, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" />
                            <WrapPanel Margin="0,12,0,0">
                                <CheckBox Content="Pflichtfeld" Margin="0,0,20,0"
                                          IsChecked="{Binding AusgewähltesFeld.Pflichtfeld}" />
                                <CheckBox Content="Schreibgeschützt"
                                          IsChecked="{Binding AusgewähltesFeld.Schreibgeschützt}" />
                            </WrapPanel>

                            <!-- Eingabe (nur bei Optionen oder Texteigenschaften) -->
                            <StackPanel Visibility="{Binding FeldHatEingabe, Converter={StaticResource BoolZuSichtbar}}">
                                <Rectangle Style="{StaticResource Trenner}" />
                                <TextBlock Text="Eingabe" Style="{StaticResource Abschnitt}" />

                                <!-- Auswahlmöglichkeiten (Dropdown/Listenfeld/Optionsfeld) -->
                                <StackPanel Visibility="{Binding FeldHatOptionen, Converter={StaticResource BoolZuSichtbar}}">
                                    <TextBlock Text="Optionen (eine je Zeile)" Style="{StaticResource Feldbeschriftung}" />
                                    <!-- Übernahme erst beim Verlassen des Feldes (LostFocus): Bei jedem
                                         Tastendruck würde das Parsen samt Seiten-Neuzeichnen die Eingabe
                                         ausbremsen und Enter/Leerzeichen hakelig machen. -->
                                    <TextBox Text="{Binding FeldOptionenText}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                                             VerticalScrollBarVisibility="Auto"
                                             ToolTip="Eine Option je Zeile – wird beim Verlassen des Feldes übernommen" />
                                    <CheckBox Content="Mehrfachauswahl erlauben" Margin="0,8,0,0"
                                              Visibility="{Binding FeldIstListenfeld, Converter={StaticResource BoolZuSichtbar}}"
                                              IsChecked="{Binding AusgewähltesFeld.MehrfachAuswahl}" />
                                </StackPanel>

                                <!-- Textfeld-Eigenschaften -->
                                <StackPanel Visibility="{Binding FeldIstText, Converter={StaticResource BoolZuSichtbar}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Max. Zeichen" Style="{StaticResource Feldbeschriftung}" />
                                            <!-- LostFocus: Der Setter meldet den normalisierten Wert zurück und
                                                 würde die Eingabe sonst bei jedem Tastendruck überschreiben. -->
                                            <TextBox Text="{Binding FeldMaxZeichenText}" ToolTip="Leer = unbegrenzt" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Visibility="{Binding FeldFormatRelevant, Converter={StaticResource BoolZuSichtbar}}">
                                            <TextBlock Text="Format / Prüfung" Style="{StaticResource Feldbeschriftung}" />
                                            <ComboBox ItemsSource="{Binding FormatWerte}"
                                                      SelectedItem="{Binding AusgewähltesFeld.Format}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Als Kästchen (gleichmäßige Felder)" Margin="0,12,0,0"
                                              IsChecked="{Binding AusgewähltesFeld.AlsKästchen}"
                                              ToolTip="Comb-Feld – benötigt eine maximale Zeichenanzahl" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Darstellung -->
                            <Rectangle Style="{StaticResource Trenner}" />
                            <TextBlock Text="Darstellung" Style="{StaticResource Abschnitt}" />
                            <TextBlock Text="Ausrichtung" Style="{StaticResource Feldbeschriftung}" />
                            <Border Padding="2" CornerRadius="6"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <UniformGrid Columns="3">
                                    <RadioButton Content="Links" Style="{StaticResource Segment}"
                                                 IsChecked="{Binding AusgewähltesFeld.Ausrichtung, Converter={StaticResource EnumGleich}, ConverterParameter=Links}" />
                                    <RadioButton Content="Mitte" Style="{StaticResource Segment}"
                                                 IsChecked="{Binding AusgewähltesFeld.Ausrichtung, Converter={StaticResource EnumGleich}, ConverterParameter=Mitte}" />
                                    <RadioButton Content="Rechts" Style="{StaticResource Segment}"
                                                 IsChecked="{Binding AusgewähltesFeld.Ausrichtung, Converter={StaticResource EnumGleich}, ConverterParameter=Rechts}" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Text="Schriftgröße (0 = automatisch)" Margin="0,12,0,4" Style="{StaticResource Feldbeschriftung}" />
                            <TextBox Text="{Binding AusgewähltesFeld.Schriftgröße, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Farben: #RRGGBB, leer = keine; das Muster zeigt die eingegebene Farbe -->
                            <TextBlock Text="Textfarbe" Margin="0,12,0,4" Style="{StaticResource Feldbeschriftung}" />
                            <DockPanel>
                                <Border Style="{StaticResource Farbmuster}"
                                        Background="{Binding AusgewähltesFeld.TextFarbe, FallbackValue=Transparent, TargetNullValue=Transparent}" />
                                <TextBox Text="{Binding AusgewähltesFeld.TextFarbe, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="#RRGGBB" />
                            </DockPanel>
                            <TextBlock Text="Rahmenfarbe (leer = keiner)" Margin="0,12,0,4" Style="{StaticResource Feldbeschriftung}" />
                            <DockPanel>
                                <Border Style="{StaticResource Farbmuster}"
                                        Background="{Binding AusgewähltesFeld.RahmenFarbe, FallbackValue=Transparent, TargetNullValue=Transparent}" />
                                <TextBox Text="{Binding AusgewähltesFeld.RahmenFarbe, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="#RRGGBB, leer = kein Rahmen" />
                            </DockPanel>
                            <TextBlock Text="Hintergrundfarbe (leer = keiner)" Margin="0,12,0,4" Style="{StaticResource Feldbeschriftung}" />
                            <DockPanel>
                                <Border Style="{StaticResource Farbmuster}"
                                        Background="{Binding AusgewähltesFeld.HintergrundFarbe, FallbackValue=Transparent, TargetNullValue=Transparent}" />
                                <TextBox Text="{Binding AusgewähltesFeld.HintergrundFarbe, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="#RRGGBB, leer = kein Hintergrund" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Ebene für die Verbindungslinie zwischen Text und Kommentarkarte -->
            <Canvas x:Name="VerbindungsEbene" Grid.Column="2" Grid.ColumnSpan="2"
                    IsHitTestVisible="False" Panel.ZIndex="50" />
        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="4" Height="28" Padding="12,0" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                TextElement.FontSize="12"
                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Grid>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SpeicherHinweis}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource PpAkzent}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SeitenStatus}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Lade-Overlay: erscheint während eine PDF geladen wird -->
        <Grid x:Name="LadeOverlay" Visibility="Collapsed"
              Grid.Row="1" Grid.RowSpan="4" Panel.ZIndex="200">
            <Grid.Background>
                <SolidColorBrush Color="#1C2B2A" Opacity="0.55" />
            </Grid.Background>
            <ui:Button Content="Über" Icon="{ui:SymbolIcon Info28}"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,8,16,0"
                       Panel.ZIndex="201"
                       Click="ÜberFensterÖffnen" />
            <Border Background="#FBFAF7" CornerRadius="12" Padding="32,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="280">
                <StackPanel HorizontalAlignment="Center">

<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF-Desktopanwendung für .NET 8, nur für Windows x64 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>PdfEditor</RootNamespace>
    <AssemblyName>perPDF</AssemblyName>
    <Product>perPDF</Product>
    <ApplicationIcon>perpdf.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Deutsche Programmoberfläche als Standardkultur -->
    <UICulture>de-DE</UICulture>
    <!-- Versionsattribute schreibt VersionSchreiben.ps1 in BuildInfo.g.cs (Quelle: Git-Tag vX.Y.Z) -->
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <!-- Im Release keine PDB-Dateien ausgeben – werden zur Laufzeit nicht benötigt -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Bei 6.2.4 bleiben: ab 6.5.0 AGPL-3.0 mit Laufzeit-Lizenzprüfung ("The loaded license is not valid") -->
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Nur Werkzeug für den Release-Build (makeappx.exe für Msix\MsixBauen.ps1), wird weder importiert noch ausgeliefert -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- App-Icon auch als Ressource für das Fenster-Icon einbinden -->
    <Resource Include="perpdf.ico" />
  </ItemGroup>

  <!-- Pre-Build: BuildInfo.g.cs aus dem Git-Tag erzeugen.
       Release-Builds geben die Version per -p:VersionVorgabe=X.Y.Z (aus dem Tag) vor. -->
  <Target Name="VersionSchreiben" BeforeTargets="CoreCompile">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\VersionSchreiben.ps1&quot; -ProjektVerzeichnis &quot;$(MSBuildProjectDirectory)&quot; -Version &quot;$(VersionVorgabe)&quot;" />
    <!-- Datei ist nicht eingecheckt: im frischen Klon existiert sie bei der Auswertung noch nicht -->
    <ItemGroup>
      <Compile Include="BuildInfo.g.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <!-- Native PDB von SkiaSharp im Release-Ordner entfernen (nicht benötigt) -->
  <Target Name="NativePdbEntfernen" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Delete Files="$(OutputPath)libSkiaSharp.pdb" />
  </Target>

</Project>

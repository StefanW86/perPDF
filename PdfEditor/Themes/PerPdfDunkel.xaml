<!-- perPDF-Farben, Theme „Dunkel“ (Werte aus dem perPDF Design System).
     Das aufgehellte Teal trägt dunklen Text (PpAufAkzent), keinen weißen. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PpAkzent" Color="#2FB5A9" />
    <SolidColorBrush x:Key="PpAkzentRand" Color="#1F8F86" />
    <SolidColorBrush x:Key="PpAkzentHover" Color="#45C4B8" />
    <SolidColorBrush x:Key="PpAufAkzent" Color="#0F1A19" />
    <SolidColorBrush x:Key="PpTeal500" Color="#5FD3C6" />
    <SolidColorBrush x:Key="PpTeal50" Color="#1C2E2C" />
    <SolidColorBrush x:Key="PpTeal100" Color="#234240" />
    <SolidColorBrush x:Key="PpTeal200" Color="#2F5753" />
    <SolidColorBrush x:Key="PpHaarlinie" Color="#34403F" />
    <SolidColorBrush x:Key="PpLeinwand" Color="#171A1A" />
    <SolidColorBrush x:Key="PpFläche" Color="#262B2A" />
    <SolidColorBrush x:Key="PpZeileAlt" Color="#2A3130" />
    <!-- Schwebende Leisten liegen auf der weißen Seite: heller als PpFläche, damit der Kontrast nicht hart wirkt. -->
    <SolidColorBrush x:Key="PpLeistenFläche" Color="#606C6A" />
    <SolidColorBrush x:Key="PpInk" Color="#E6EFEE" />
    <SolidColorBrush x:Key="PpGedämpft" Color="#93A8A7" />
    <SolidColorBrush x:Key="PpOrange" Color="#F4A93B" />
    <SolidColorBrush x:Key="PpAbgelehntGrund" Color="#3A2023" />
    <SolidColorBrush x:Key="PpAbgelehntRand" Color="#6B3036" />
    <SolidColorBrush x:Key="PpAbgelehnt" Color="#FF99A4" />
</ResourceDictionary>

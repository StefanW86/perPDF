<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX-Manifest fuer die Microsoft-Store-Einreichung (der Store signiert das Paket).
     Identity Name/Publisher und PublisherDisplayName MUESSEN exakt den Werten aus
     Partner Center (Produktidentitaet) entsprechen. Version setzt MsixBauen.ps1 ein. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap desktop6">

  <Identity
    Name="StefanWendrich.perPDF"
    Publisher="CN=E1C64AE3-6557-4B03-9B72-9599D8A81A65"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>perPDF</DisplayName>
    <PublisherDisplayName>Stefan Wendrich</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Schreibzugriffe auf %AppData%\Roaming\perPDF (Signaturen, Fensterzustand) nicht in den
         Paketspeicher umleiten: Daten bleiben mit der MSI-Version geteilt und ueberleben die Deinstallation.
         Erfordert die Capability unvirtualizedResources (in Partner Center begruenden). -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="de-DE" />
  </Resources>

  <Applications>
    <Application Id="perPDF" Executable="perPDF.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="perPDF"
        Description="PDF-Editor perPDF"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Nur als moegliche PDF-Anwendung registrieren, Standard waehlt der Benutzer. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF-Dokument</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
